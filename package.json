{
  "name": "jetlog-cli",
  "version": "0.1.0",
  "description": "Command-line tool for Jetlog: convert and import pilot logbook data, compute flight times, and connect AI tools over MCP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvdvleuten/jetlog-cli.git"
  },
  "homepage": "https://jetlog.app",
  "bugs": {
    "url": "https://github.com/jvdvleuten/jetlog-cli/issues"
  },
  "keywords": [
    "jetlog",
    "pilot",
    "logbook",
    "aviation",
    "mcp",
    "logten",
    "pilotlog",
    "foreflight"
  ],
  "type": "module",
  "bin": {
    "jetlog": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "openai": "^7.27.0",
    "unpdf": "^1.8.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
