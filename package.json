{
  "name": "jetlog-cli",
  "version": "0.1.1",
  "description": "Command-line tool for Jetlog: convert and import pilot logbook data, compute flight times, and connect AI tools over MCP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvdvleuten/jetlog-cli.git"
  },
  "homepage": "https://jetlog.app",
  "bugs": {
    "url": "https://github.com/jvdvleuten/jetlog-cli/issues"
  },
  "keywords": [
    "jetlog",
    "pilot",
    "logbook",
    "aviation",
    "mcp",
    "logten",
    "pilotlog",
    "foreflight"
  ],
  "type": "module",
  "bin": {
    "jetlog": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/chunks",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^24.0.0",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "unpdf": "^1.8.1",
    "uqr": "^0.1.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "mcpName": "io.github.jvdvleuten/jetlog"
}
